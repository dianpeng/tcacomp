// mlp — THE map|reduce|map fusion flagship: GEMM + GELU.
//   GELU(v) = 0.5f*v*(1.0f + tanhf(0.79788456f*(v + 0.044715f*v*v*v)))
//
// FALLBACK VARIANT (spike wall, recorded in SUMMARY): the primary form's
// piped map with a tensor binding on(bias[j]) was accepted by the frontend
// but rejected by the final-lower pass (P-12: the moved consumer references
// a dimvar whose loop does not enclose the bracket block). The documented
// fallback ships: bias-free GELU MLP with a pure elementwise piped map.
@runtime(cxx_path="runtime/tca_runtime.h");
@name(cxx="Mlp")
kernel mlp(
  lhs: tensor<dtype=f32, shape=[M, K]>,
  rhs: tensor<dtype=f32, shape=[K, N]>,
) -> tensor<dtype=f32, shape=[M, N]>
{
  dimvar (i, j, k);
  let out = map
    on(lhs[i][k], rhs[k][j])
    (l: f32, r: f32) -> f32:
      l * r
  | reduce(init = 0.0f)
    on(acc: f32, %0: f32)
    as (i, j) -> f32:
      acc + %0
  | map
    on()
    (v: f32) -> f32:
      0.5f*v*(1.0f + tanhf(0.79788456f*(v + 0.044715f*v*v*v)))
  ;
  return out;
}
