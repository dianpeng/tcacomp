// mm_mid — mid-size tiled matmul; SMEM window promotion expected.
@runtime(cxx_path="runtime/tca_runtime.h");
@name(cxx="MmMid")
kernel mm_mid(
  lhs: tensor<dtype=f32, shape=[M, K]>,
  rhs: tensor<dtype=f32, shape=[K, N]>,
) -> tensor<dtype=f32, shape=[M, N]>
{
  dimvar (i, j, k);
  let out = map
    on(lhs[i][k], rhs[k][j])
    (l: f32, r: f32) -> f32:
      l * r
  | reduce(init = 0.0f)
    on(acc: f32, %0: f32)
    as (i, j) -> f32:
      acc + %0
  ;
  return out;
}
