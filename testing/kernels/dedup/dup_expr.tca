// dup_expr — dedup/GVN coverage: the map lambda deliberately repeats the
// identical subexpression (v*v + v*v) so HIR GVN must fold the duplicates.
//
// FALLBACK VARIANTS (spike walls, recorded in SUMMARY):
// (1) the v0 pkg rungs require at least one reduction before the store, so
//     the pure-elementwise form (map only) is not expressible — the
//     repeated subexpressions moved into a root map over a trailing
//     reduced axis;
// (2) a single-input reduction of that shape selects the v0-unreachable
//     GlobalReducer in the schedule (the runtime asserts "GlobalReducer:
//     not enabled in v0" at launch — recorded as a compiler defect), so a
//     second operand z carries the map into the WARP-reducer schedule
//     class. out[i][j] = sum_k f(x[i][j][k]) * z[i][j][k]; f holds the
//     repeated subexprs — the dedup coverage is unchanged.
// const-K declaration (mixed dynamic/static form per design/fix/fix6.md —
// fully-static is blocked by D-fix6-01/03): the trailing reduced extent is
// a compile-time constant, Ku = 8.
@runtime(cxx_path="runtime/tca_runtime.h");
@name(cxx="DupExpr")
kernel dup_expr(
  x: tensor<dtype=f32, shape=[R, C, 8u]>,
  z: tensor<dtype=f32, shape=[R, C, 8u]>,
  gain: f32,
  bias: f32,
) -> tensor<dtype=f32, shape=[R, C]>
{
  dimvar (i, j, k);
  let out = map
    on(x[i][j][k], z[i][j][k])
    [gain, bias] (v: f32, w: f32) -> f32:
      ((v*v + v*v) * gain + (v*v + v*v) * bias) * w
  | reduce(init = 0.0f)
    on(acc: f32, %0: f32)
    as (i, j) -> f32:
      acc + %0
  ;
  return out;
}
