// dup_const — tail const-dedup coverage: one nested polynomial reusing the
// SAME four literal constants (the GELU family 0.5f, 1.0f, 0.79788456f,
// 0.044715f) many times; the TAIL const-dedup pass must collapse the
// duplicates. No scalar params.
//
// FALLBACK VARIANTS (spike walls, recorded in SUMMARY): same two walls as
// dup_expr — the map-only form is not a v0 rung shape, and the single-input
// reduction selects the v0-unreachable GlobalReducer (recorded compiler
// defect), so a second operand z weights the polynomial; the literal-reuse
// coverage is unchanged.
@runtime(cxx_path="runtime/tca_runtime.h");
@name(cxx="DupConst")
kernel dup_const(
  x: tensor<dtype=f32, shape=[R, C, K]>,
  z: tensor<dtype=f32, shape=[R, C, K]>,
) -> tensor<dtype=f32, shape=[R, C]>
{
  dimvar (i, j, k);
  let out = map
    on(x[i][j][k], z[i][j][k])
    (v: f32, w: f32) -> f32:
      (0.5f * (v + 0.5f * v * v) * (1.0f + 0.044715f * v) + tanhf(0.79788456f * (v + 0.044715f * v) + 0.79788456f * 0.5f * v) * (1.0f - 0.5f)) * w
  | reduce(init = 0.0f)
    on(acc: f32, %0: f32)
    as (i, j) -> f32:
      acc + %0
  ;
  return out;
}
