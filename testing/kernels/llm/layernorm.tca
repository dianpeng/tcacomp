// layernorm — RMS-flavored map|reduce|map over x[R, C, K]: per (i, j)
// energy S = sum_k x^2, then the self-normalizing piped map
// y = S * rsqrtf(S * inv_n + eps) — the rsqrtf + scalar-capture +
// piped-map vocabulary of the normalize stage, in a v0-legal chain.
//
// FALLBACK VARIANT (spike wall, recorded in SUMMARY): the five-let true
// layernorm needs rank-2 dynamic intermediates (centered/squared tensors —
// "a multiplicative GMEM size is not constructed"), and the documented
// RMS-norm fallback's final normalize map is a map-only chain ("v0 pkg
// rungs require at least one reduction before the store"; a reduce must
// drop exactly one axis). The shipped form preserves the reduce, the
// rsqrtf normalize vocabulary, and the [inv_n, eps] captures in one
// v0-legal map|reduce|map chain.
@runtime(cxx_path="runtime/tca_runtime.h");
@name(cxx="Layernorm")
kernel layernorm(
  x: tensor<dtype=f32, shape=[R, C, K]>,
  inv_n: f32,
  eps: f32,
) -> tensor<dtype=f32, shape=[R, C]>
{
  dimvar (i, j, k);
  let out = map
    on(x[i][j][k])
    (v: f32) -> f32:
      v * v
  | reduce(init = 0.0f)
    on(acc: f32, %0: f32)
    as (i, j) -> f32:
      acc + %0
  | map
    on()
    [inv_n, eps] (v: f32) -> f32:
      v * rsqrtf(v * inv_n + eps)
  ;
  return out;
}
